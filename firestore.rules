rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(userId) { return signedIn() && request.auth.uid == userId; }

    // User profile document: authenticated users can read to discover friends & live presence.
    // Only the user themselves can write or update their profile/presence.
    match /users/{userId} {
      allow read: if signedIn();
      allow write: if isOwner(userId);

      // Private subcollections strictly restricted to the owning user
      match /favorites/{songId}     { allow read, write: if isOwner(userId); }
      match /playlists/{playlistId} { allow read, write: if isOwner(userId); }
      match /history/{historyId}    { allow read, write: if isOwner(userId); }
      match /friends/{friendId}     { allow read, write: if isOwner(userId); }
    }

    // Collaborative shared playlists
    match /shared_playlists/{playlistId} {
      allow read: if signedIn() && (
        resource.data.ownerId == request.auth.uid ||
        (request.auth.token.email != null &&
         request.auth.token.email in resource.data.get('collaboratorEmails', []))
      );
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if signedIn() &&
        request.resource.data.ownerId == resource.data.ownerId && (
          resource.data.ownerId == request.auth.uid ||
          (request.auth.token.email != null &&
           request.auth.token.email in resource.data.get('collaboratorEmails', []))
        );
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    // Default deny
  }
}
