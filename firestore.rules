rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(userId) { return signedIn() && request.auth.uid == userId; }

    // PRIVATE: only the owner can read/write their account data (incl. email).
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /favorites/{songId}     { allow read, write: if isOwner(userId); }
      match /playlists/{playlistId} { allow read, write: if isOwner(userId); }
      match /history/{historyId}    { allow read, write: if isOwner(userId); }
      match /friends/{friendId}     { allow read, write: if isOwner(userId); }
    }

    // PUBLIC (minimal): display name + lowercase email so people can be found
    // by exact email. Bulk listing is blocked (queries may return 1 result).
    match /public_profiles/{uid} {
      allow get: if signedIn();
      allow list: if signedIn() && request.query.limit <= 1;
      allow create, update: if isOwner(uid) &&
        request.resource.data.keys().hasOnly(['displayName', 'emailLower', 'updatedAt']);
      allow delete: if isOwner(uid);
    }

    // LIVE PRESENCE: readable one-by-one by id (no listing, no email inside).
    match /presence/{uid} {
      allow get: if signedIn();
      allow list: if false;
      allow write: if isOwner(uid);
    }

    // Collaborative shared playlists
    match /shared_playlists/{playlistId} {
      allow read: if signedIn() && (
        resource.data.ownerId == request.auth.uid ||
        (request.auth.token.email != null &&
         request.auth.token.email in resource.data.get('collaboratorEmails', []))
      );
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if signedIn() &&
        request.resource.data.ownerId == resource.data.ownerId && (
          resource.data.ownerId == request.auth.uid ||
          (request.auth.token.email != null &&
           request.auth.token.email in resource.data.get('collaboratorEmails', []))
        );
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    // Everything else is denied by default.
  }
}
